# EditorConfig — https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,xml,xaml,csproj,props,targets}]
indent_size = 2

[*.cs]
indent_size = 4

[*.sln]
indent_style = tab
