<Window x:Class="Simulate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFI - Automotive Fault Injector"
        Height="800" Width="1380"
        MinHeight="700" MinWidth="1200"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- 0: Title bar       -->
            <RowDefinition Height="Auto"/> <!-- 1: Top cards       -->
            <RowDefinition Height="*"/>    <!-- 2: Middle cards    -->
            <RowDefinition Height="168"/>  <!-- 3: Fault Queue     -->
            <RowDefinition Height="152"/>  <!-- 4: Bottom cards    -->
            <RowDefinition Height="26"/>   <!-- 5: Status bar      -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             ROW 0 · TITLE BAR
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBg}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="10,0,4,0">

                <!-- Left: Logo + Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="3"
                            Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="AFI" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Automotive Fault Injector"
                                   FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="CANoe / Driver-Based CAN &amp; CAN FD Testing"
                                   FontSize="9" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Window controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="?" Style="{StaticResource WinBtnStyle}" FontWeight="Bold"/>
                    <Button Content="⚙" Style="{StaticResource WinBtnStyle}"/>
                    <Button Content="─" Style="{StaticResource WinBtnStyle}" Click="BtnMinimize_Click"/>
                    <Button Content="❐" Style="{StaticResource WinBtnStyle}" Click="BtnMaximize_Click"/>
                    <Button Content="✕" Style="{StaticResource WinCloseBtnStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 1 · TOP 3 CARDS
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="10,8,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 1. CONNECTION / SETUP ────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title + Status -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="1. CONNECTION / SETUP" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGreen}"
                                     Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Connected" Foreground="{StaticResource AccentGreen}"
                                       FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Interface / TX Channel / RX Channel / Baudrate / Refresh -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                            <TextBlock Text="Interface / Driver" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="CANoe"/>
                                <ComboBoxItem Content="Vector XL"/>
                                <ComboBoxItem Content="Kvaser"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2,0,2,0">
                            <TextBlock Text="TX Channel" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="CAN 1"/>
                                <ComboBoxItem Content="CAN 2"/>
                                <ComboBoxItem Content="CAN 3"/>
                                <ComboBoxItem Content="CAN 4"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="2,0,2,0">
                            <TextBlock Text="RX Channel" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="CAN 1"/>
                                <ComboBoxItem Content="CAN 2"/>
                                <ComboBoxItem Content="CAN 3"/>
                                <ComboBoxItem Content="CAN 4"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="3,0,0,0">
                            <TextBlock Text="Baudrate" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="500 kbps"/>
                                <ComboBoxItem Content="250 kbps"/>
                                <ComboBoxItem Content="1 Mbps"/>
                            </ComboBox>
                        </StackPanel>
                        <!-- Refresh device list button -->
                        <StackPanel Grid.Column="4" Margin="3,0,0,0">
                            <TextBlock Text=" " Style="{StaticResource FieldLabelStyle}"/>
                            <Button Content="⟳"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    Foreground="#38BDF8"
                                    Width="28" FontSize="14" FontWeight="Bold"
                                    ToolTip="Refresh CAN interfaces and channels"/>
                        </StackPanel>
                    </Grid>

                    <!-- CAN FD toggle + Data Phase Baudrate -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="CAN FD" Style="{StaticResource FieldLabelStyle}"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Border Width="34" Height="18" Background="{StaticResource AccentBlue}"
                                    CornerRadius="9" Padding="2">
                                <Ellipse Width="14" Height="14" Fill="White" HorizontalAlignment="Right"/>
                            </Border>
                            <TextBlock Text="ON" Foreground="White" FontSize="9" FontWeight="Bold"
                                       Margin="4,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="  ⓘ" Foreground="{StaticResource TextMuted}" FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Data Phase Baudrate" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="2 Mbps"/>
                                <ComboBoxItem Content="5 Mbps"/>
                                <ComboBoxItem Content="8 Mbps"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Disconnect / Connect / Refresh -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🔌  Disconnect"
                                Background="{StaticResource AccentBlue}" Margin="0,0,3,0"/>
                        <Button Grid.Column="1" Content="Connect"
                                Background="Transparent"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                Foreground="{StaticResource TextMuted}" IsEnabled="False" Margin="3,0,3,0"/>
                        <Button Grid.Column="2" Content="⟳  Refresh"
                                Background="Transparent"
                                BorderBrush="#38BDF8" BorderThickness="1"
                                Foreground="#38BDF8"
                                Padding="10,4"
                                ToolTip="Rescan CAN interfaces — use after plugging or unplugging a device"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── 2. DBC MANAGEMENT ─────────────────────────────── -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="2,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="2. DBC MANAGEMENT" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Grid.Row="1" Text="Loaded DBC File" Style="{StaticResource FieldLabelStyle}"/>

                    <!-- File row -->
                    <Border Grid.Row="2" Background="{StaticResource LogBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="3" Padding="8,5" Margin="0,2,0,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="Vehicle_Network.dbc"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="✓" Foreground="{StaticResource AccentGreen}" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Stats -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Messages" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="256" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Nodes" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="28" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Signals" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="1024" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Grid>

                    <!-- Buttons -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📁  Load DBC"
                                Background="{StaticResource AccentBlue}" Margin="0,0,3,0"/>
                        <Button Grid.Column="1" Content="🗑  Unload DBC"
                                Background="Transparent"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                Foreground="{StaticResource TextSecondary}" Margin="3,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── 10. STATUS OVERVIEW ───────────────────────────── -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="10. STATUS OVERVIEW" Style="{StaticResource CardTitleStyle}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Connection" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreen}"
                                         Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Connected" Foreground="{StaticResource AccentGreen}"
                                           FontWeight="Bold" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Text="Driver" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="CANoe 17.0" Foreground="White" FontSize="10" Margin="0,0,0,6"/>
                            <TextBlock Text="Bus State" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Background="#064E3B" CornerRadius="3" Padding="7,2" HorizontalAlignment="Left">
                                <TextBlock Text="Active" Foreground="{StaticResource AccentGreen}"
                                           FontWeight="Bold" FontSize="9"/>
                            </Border>
                        </StackPanel>

                        <!-- Right -->
                        <StackPanel Grid.Column="1" Margin="2,0,0,0">
                            <TextBlock Text="DBC" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="Vehicle_Network.dbc (256 msgs)"
                                       Foreground="White" FontSize="9"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                            <TextBlock Text="Bus Health" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="💚 " FontSize="10"/>
                                <TextBlock Text="100%" Foreground="{StaticResource AccentGreen}"
                                           FontWeight="Bold" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Text="CAN FD" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="Enabled (2 Mbps)" Foreground="White" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             ROW 2 · MIDDLE 3 CARDS
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="3.3*"/>
                <ColumnDefinition Width="2.1*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 3. MESSAGE BROWSER ────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="3. MESSAGE BROWSER" Style="{StaticResource CardTitleStyle}"/>
                    <TextBox Grid.Row="1" Text="🔍  Search messages..."
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Messages}" SelectedIndex="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID (Hex)"     Binding="{Binding Id}"    Width="62"/>
                            <DataGridTextColumn Header="Message Name" Binding="{Binding Name}"  Width="*"/>
                            <DataGridTextColumn Header="DLC"          Binding="{Binding Dlc}"   Width="34"/>
                            <DataGridTextColumn Header="Cycle Time"   Binding="{Binding Cycle}" Width="68"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="Total Messages: 256"
                               FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </Grid>
            </Border>

            <!-- ── 4. SIGNAL BROWSER / CONFIGURATION ────────────── -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="2,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="4. SIGNAL BROWSER / CONFIGURATION"
                               Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Grid.Row="1" Text="Message: 0x100 - EngineData"
                               FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="2" Text="🔍  Search signals..."
                             Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Signals}" SelectedIndex="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Signal Name" Binding="{Binding Name}"     Width="*"/>
                            <DataGridTextColumn Header="Start Bit"   Binding="{Binding StartBit}" Width="52"/>
                            <DataGridTextColumn Header="Length"      Binding="{Binding Length}"   Width="42"/>
                            <DataGridTextColumn Header="Factor"      Binding="{Binding Factor}"   Width="44"/>
                            <DataGridTextColumn Header="Offset"      Binding="{Binding Offset}"   Width="40"/>
                            <DataGridTextColumn Header="Unit"        Binding="{Binding Unit}"     Width="36"/>
                            <DataGridTextColumn Header="Min"         Binding="{Binding Min}"      Width="36"/>
                            <DataGridTextColumn Header="Max"         Binding="{Binding Max}"      Width="44"/>
                            <DataGridTextColumn Header="Value"       Binding="{Binding Value}"    Width="48"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ── 5. FAULT CONFIGURATION ────────────────────────── -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="5. FAULT CONFIGURATION" Style="{StaticResource CardTitleStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Fault Type -->
                            <TextBlock Text="Fault Type" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedIndex="0" Margin="0,0,0,7">
                                <ComboBoxItem Content="Stuck at Value"/>
                                <ComboBoxItem Content="Bit Flip"/>
                                <ComboBoxItem Content="Offset"/>
                                <ComboBoxItem Content="Delay Frame"/>
                                <ComboBoxItem Content="Random Noise"/>
                            </ComboBox>

                            <!-- Value -->
                            <TextBlock Text="Value" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="0x00" Margin="0,0,0,7"/>

                            <!-- Start Time / Duration -->
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                    <TextBlock Text="Start Time" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="0"/>
                                        <TextBlock Grid.Column="1" Text=" s"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                    <TextBlock Text="Duration" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="10"/>
                                        <TextBlock Grid.Column="1" Text=" s"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Repeat toggle + Count -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            VerticalAlignment="Bottom" Margin="0,0,8,0">
                                    <TextBlock Text="Repeat" Style="{StaticResource FieldLabelStyle}"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Border Width="30" Height="16" Background="{StaticResource AccentBlue}"
                                            CornerRadius="8" Padding="1">
                                        <Ellipse Width="12" Height="12" Fill="White" HorizontalAlignment="Right"/>
                                    </Border>
                                    <TextBlock Text="ON" Foreground="White" FontSize="9" FontWeight="Bold"
                                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Count" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="(0 = Infinite)" FontSize="9"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Right" Margin="0,2,0,7"/>

                            <!-- Injection Mode -->
                            <TextBlock Text="Injection Mode" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="Override Message"/>
                                <ComboBoxItem Content="Corrupt CRC"/>
                                <ComboBoxItem Content="Drop Frame"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="➕  Add to Queue"
                            Background="{StaticResource AccentBlue}" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             ROW 3 · FAULT INJECTION QUEUE / LIST
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="5" Padding="10" Margin="10,0,10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <TextBlock Text="8. FAULT INJECTION QUEUE / LIST"
                               Style="{StaticResource CardTitleStyle}" Margin="0"/>
                    <TextBlock Text="Total: 3" Foreground="{StaticResource TextMuted}"
                               FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding FaultQueue}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"              Binding="{Binding Index}"     Width="28"/>
                        <DataGridTextColumn Header="Message (ID)"  Binding="{Binding MsgId}"     Width="82"/>
                        <DataGridTextColumn Header="Message Name"  Binding="{Binding MsgName}"   Width="88"/>
                        <DataGridTextColumn Header="Signal"        Binding="{Binding Signal}"    Width="88"/>
                        <DataGridTextColumn Header="Fault Type"    Binding="{Binding FaultType}" Width="100"/>
                        <DataGridTextColumn Header="Fault Value"   Binding="{Binding FaultValue}" Width="108"/>
                        <DataGridTextColumn Header="Start Time"    Binding="{Binding StartTime}" Width="62"/>
                        <DataGridTextColumn Header="Duration"      Binding="{Binding Duration}"  Width="58"/>
                        <DataGridTextColumn Header="Repeat"        Binding="{Binding Repeat}"    Width="55"/>
                        <DataGridTextColumn Header="Injection Mode" Binding="{Binding Mode}"     Width="93"/>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="Status" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg}" CornerRadius="3"
                                            Padding="7,2" HorizontalAlignment="Left" Margin="2,2">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="▶" Style="{StaticResource ActionBtnStyle}"
                                                Foreground="#10B981" ToolTip="Run"/>
                                        <Button Content="□" Style="{StaticResource ActionBtnStyle}"
                                                ToolTip="Stop"/>
                                        <Button Content="✏" Style="{StaticResource ActionBtnStyle}"
                                                ToolTip="Edit"/>
                                        <Button Content="🗑" Style="{StaticResource ActionBtnStyle}"
                                                Foreground="#EF4444" ToolTip="Delete"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 4 · BOTTOM 3 CARDS
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="4" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="3.7*"/>
                <ColumnDefinition Width="2.1*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 7. EXECUTION CONTROL ──────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="7. EXECUTION CONTROL" Style="{StaticResource CardTitleStyle}"/>
                    <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                        <Button Content="▶  Start Injection" Background="#16A34A" Margin="2"/>
                        <Button Content="■  Stop"            Background="{StaticResource AccentRed}" Margin="2"/>
                        <Button Content="❚❚  Pause"          Background="#92400E" Margin="2"/>
                        <Button Content="🗑  Clear All"
                                Background="Transparent"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                Foreground="{StaticResource TextSecondary}" Margin="2"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- ── 8. LOG / OUTPUT ───────────────────────────────── -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="2,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <TextBlock Text="8. LOG / OUTPUT" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox SelectedIndex="0" Width="82" Margin="0,0,4,0">
                                <ComboBoxItem Content="All Levels"/>
                                <ComboBoxItem Content="INFO"/>
                                <ComboBoxItem Content="DEBUG"/>
                                <ComboBoxItem Content="ERROR"/>
                            </ComboBox>
                            <Button Content="Clear"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    Foreground="{StaticResource TextSecondary}"
                                    Padding="8,2" Height="26" Margin="0,0,4,0"/>
                            <Button Content="⬆ Export"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    Foreground="{StaticResource TextSecondary}"
                                    Padding="8,2" Height="26"/>
                        </StackPanel>
                    </Grid>

                    <!-- Log output -->
                    <Border Grid.Row="1" Background="{StaticResource LogBg}" CornerRadius="3">
                        <ScrollViewer Padding="8,5" VerticalScrollBarVisibility="Auto">
                            <StackPanel TextElement.FontFamily="Consolas" TextElement.FontSize="10">
                                <TextBlock>
                                    <Run Foreground="#64748B">14:30:25.123</Run><Run Foreground="#64748B">  </Run>
                                    <Run Foreground="#10B981" FontWeight="SemiBold">[INFO]</Run>
                                    <Run Foreground="#94A3B8">  Connected to CANoe on channel CAN 1 (500 kbps / 2 Mbps FD)</Run>
                                </TextBlock>
                                <TextBlock>
                                    <Run Foreground="#64748B">14:30:25.456</Run><Run Foreground="#64748B">  </Run>
                                    <Run Foreground="#10B981" FontWeight="SemiBold">[INFO]</Run>
                                    <Run Foreground="#94A3B8">  DBC loaded: Vehicle_Network.dbc (Messages: 256, Nodes: 28, Signals: 1024)</Run>
                                </TextBlock>
                                <TextBlock>
                                    <Run Foreground="#64748B">14:30:26.001</Run><Run Foreground="#64748B">  </Run>
                                    <Run Foreground="#10B981" FontWeight="SemiBold">[INFO]</Run>
                                    <Run Foreground="#94A3B8">  Added fault to queue: EngineData.EngineSpeed - Stuck at Value (0x0000)</Run>
                                </TextBlock>
                                <TextBlock>
                                    <Run Foreground="#64748B">14:30:26.210</Run><Run Foreground="#64748B">  </Run>
                                    <Run Foreground="#10B981" FontWeight="SemiBold">[INFO]</Run>
                                    <Run Foreground="#94A3B8">  Injection started</Run>
                                </TextBlock>
                                <TextBlock>
                                    <Run Foreground="#64748B">14:30:26.345</Run><Run Foreground="#64748B">  </Run>
                                    <Run Foreground="#38BDF8" FontWeight="SemiBold">[DEBUG]</Run>
                                    <Run Foreground="#64748B">  Injecting 0x100 - EngineData (EngineSpeed = 0x0000)</Run>
                                </TextBlock>
                                <TextBlock>
                                    <Run Foreground="#64748B">14:30:31.002</Run><Run Foreground="#64748B">  </Run>
                                    <Run Foreground="#10B981" FontWeight="SemiBold">[INFO]</Run>
                                    <Run Foreground="#94A3B8">  Fault executed: 0x102 - BrakeStatus.BrakeApplied - Bit Flip (Bit 0)</Run>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- ── 9. BUS MONITOR (HEALTH) ───────────────────────── -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="9. BUS MONITOR (HEALTH)" Style="{StaticResource CardTitleStyle}"/>

                    <!-- Waveform chart -->
                    <Border Grid.Row="1" Background="{StaticResource LogBg}" CornerRadius="3" Margin="0,2,0,4">
                        <Viewbox Stretch="Fill">
                            <!-- Fixed coordinate canvas scaled by Viewbox -->
                            <Canvas Width="310" Height="88">
                                <!-- Y-axis grid lines -->
                                <Line X1="30" Y1="7"  X2="308" Y2="7"  Stroke="#1A2640" StrokeThickness="0.7"/>
                                <Line X1="30" Y1="40" X2="308" Y2="40" Stroke="#1A2640" StrokeThickness="0.7"/>
                                <Line X1="30" Y1="73" X2="308" Y2="73" Stroke="#1A2640" StrokeThickness="0.7"/>
                                <!-- Y labels -->
                                <TextBlock Text="100%" FontSize="6" Foreground="#64748B" Canvas.Left="0"  Canvas.Top="4"/>
                                <TextBlock Text="50%"  FontSize="6" Foreground="#64748B" Canvas.Left="2"  Canvas.Top="37"/>
                                <TextBlock Text="0%"   FontSize="6" Foreground="#64748B" Canvas.Left="5"  Canvas.Top="70"/>
                                <!-- Waveform (~24% bus load) -->
                                <Polyline
                                    Points="30,57 48,52 66,59 84,49 102,55 120,48 138,56 156,50 174,54 192,47 210,55 228,49 246,57 264,51 282,54 300,50 308,53"
                                    Stroke="#10B981" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                <!-- X-axis labels -->
                                <TextBlock Text="-60s" FontSize="5.5" Foreground="#64748B" Canvas.Left="26"  Canvas.Top="77"/>
                                <TextBlock Text="-45s" FontSize="5.5" Foreground="#64748B" Canvas.Left="82"  Canvas.Top="77"/>
                                <TextBlock Text="-30s" FontSize="5.5" Foreground="#64748B" Canvas.Left="150" Canvas.Top="77"/>
                                <TextBlock Text="-15s" FontSize="5.5" Foreground="#64748B" Canvas.Left="216" Canvas.Top="77"/>
                                <TextBlock Text="Now"  FontSize="5.5" Foreground="#64748B" Canvas.Left="280" Canvas.Top="77"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- Stats row -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bus Load"     Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="24.7%"        Foreground="{StaticResource AccentGreen}"
                                       FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Error Frames" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="0"            Foreground="White"
                                       FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lost Frames"  Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="0"            Foreground="White"
                                       FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Warning"      Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="0"            Foreground="{StaticResource AccentYellow}"
                                       FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             ROW 5 · STATUS BAR
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="5"
                Background="{StaticResource HeaderBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGreen}"
                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ready"           Foreground="White"  FontSize="10" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="Tx: 12,345 msgs/s" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,16,0"/>
                    <TextBlock Text="Rx: 12,312 msgs/s" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,16,0"/>
                    <TextBlock Text="Errors: 0"       Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,16,0"/>
                    <TextBlock Text="Bus Load: 24.7%" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,6,0"/>
                    <ProgressBar Value="24.7" Width="60" Height="5"
                                 Foreground="{StaticResource AccentGreen}"
                                 Background="#1E2C48" BorderThickness="0"
                                 VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Time: 2025-05-20 14:30:31" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,16,0"/>
                    <TextBlock Text="Session: 00:02:15"          Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
