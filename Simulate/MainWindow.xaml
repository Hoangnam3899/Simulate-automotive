<Window x:Class="Simulate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFI - Automotive Fault Injector"
        Width="1380" Height="800" MinWidth="1100" MinHeight="650"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="8"/>
        </Style>
        <Style x:Key="TinyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style x:Key="GridText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="LedStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Connection.IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LedTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="Disconnected"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Connection.IsConnected}" Value="True">
                    <Setter Property="Text" Value="Connected"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1.23*"/>
            <RowDefinition Height="1.23*"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="10,0,4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="0,0,9,0"><TextBlock Text="AFI" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="13"/></Border>
                    <StackPanel><TextBlock Text="Automotive Fault Injector" Foreground="White" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="CAN Injection &amp; Testing" Foreground="{StaticResource TextMuted}" FontSize="8"/></StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Content="?" ToolTip="Help" Style="{StaticResource WinBtnStyle}"/>
                    <Button Content="&#x2699;" ToolTip="Settings" Style="{StaticResource WinBtnStyle}"/>
                    <Button Content="-" ToolTip="Minimize" Style="{StaticResource WinBtnStyle}" Click="BtnMinimize_Click"/>
                    <Button Content="&#x25A1;" ToolTip="Maximize" Style="{StaticResource WinBtnStyle}" Click="BtnMaximize_Click"/>
                    <Button Content="x" ToolTip="Close" Style="{StaticResource WinCloseBtnStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top row: connection, DBC, overview -->
        <Grid Grid.Row="1" Margin="8,4,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,3,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="1. CONNECTION / SETUP" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="6" Height="6" Style="{StaticResource LedStyle}" Margin="0,0,4,0"/><TextBlock Style="{StaticResource LedTextStyle}"/></StackPanel></Grid>
                <Grid Grid.Row="1" Margin="0,7,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,4,0"><TextBlock Text="Interface / Driver" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableInterfaces}" SelectedItem="{Binding Connection.SelectedInterface}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22" DisplayMemberPath="Name"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="2,0"><TextBlock Text="TX Channel" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableChannels}" SelectedItem="{Binding Connection.SelectedTx}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22" DisplayMemberPath="Name"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="2,0,0,0"><TextBlock Text="RX Channel" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableChannels}" SelectedItem="{Binding Connection.SelectedRx}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22" DisplayMemberPath="Name"/></StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><TextBlock Text="CAN FD" Style="{StaticResource TinyLabel}" Margin="0,0,7,4"/><CheckBox IsChecked="{Binding Connection.IsCanFdEnabled}" IsEnabled="{Binding Connection.CanEditConnectionSettings}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="2,0"><TextBlock Text="Baudrate TX" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableBaudrates}" SelectedItem="{Binding Connection.BaudrateTx}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="2,0,0,0"><TextBlock Text="Baudrate RX" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableBaudrates}" SelectedItem="{Binding Connection.BaudrateRx}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22"/></StackPanel>
                </Grid>
                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Disconnect" Command="{Binding Connection.DisconnectCommand}" Style="{StaticResource TinyButton}" Margin="0,0,3,0"/><Button Grid.Column="1" Content="Connect" Command="{Binding Connection.ConnectCommand}" Style="{StaticResource TinyButton}" Margin="3,0"/><Button Grid.Column="2" Content="Refresh" Command="{Binding Connection.RefreshInterfacesCommand}" ToolTip="Refresh CAN interfaces" Style="{StaticResource TinyButton}" Background="Transparent" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Foreground="{StaticResource AccentCyan}" Margin="3,0,0,0"/></Grid>
            </Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="3,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="2. DBC MANAGEMENT" Style="{StaticResource SectionTitle}"/><StackPanel Grid.Row="1" Margin="0,7,0,3"><TextBlock Text="Loaded DBC File" Style="{StaticResource TinyLabel}"/><Border Background="{StaticResource LogBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="2" Padding="7,4"><Grid><TextBlock Text="Vehicle_Network.dbc" Style="{StaticResource TinyText}" FontWeight="SemiBold"/><TextBlock Text="&#x2713;" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/></Grid></Border></StackPanel>
                <Grid Grid.Row="2" Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Messages" Style="{StaticResource TinyLabel}"/><TextBlock Text="256" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Nodes" Style="{StaticResource TinyLabel}"/><TextBlock Text="28" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Signals" Style="{StaticResource TinyLabel}"/><TextBlock Text="1024" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel></Grid>
                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Load DBC" Style="{StaticResource TinyButton}" Margin="0,0,3,0"/><Button Grid.Column="1" Content="Unload DBC" Style="{StaticResource TinyButton}" Background="Transparent" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Foreground="{StaticResource TextSecondary}" Margin="3,0,0,0"/></Grid>
            </Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="3,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="10. STATUS OVERVIEW" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Connection" Style="{StaticResource TinyLabel}"/><TextBlock Text="● Connected" Foreground="{StaticResource AccentGreen}" FontSize="9" Margin="0,1,0,6"/><TextBlock Text="Driver" Style="{StaticResource TinyLabel}"/><TextBlock Text="CANoe 17.0" Style="{StaticResource TinyText}" Margin="0,1,0,6"/><TextBlock Text="Bus State" Style="{StaticResource TinyLabel}"/><TextBlock Text="Active" Foreground="{StaticResource AccentGreen}" FontSize="9" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DBC" Style="{StaticResource TinyLabel}"/><TextBlock Text="Vehicle_Network.dbc (256 msgs)" Style="{StaticResource TinyText}" Margin="0,1,0,6"/><TextBlock Text="Bus Health" Style="{StaticResource TinyLabel}"/><TextBlock Text="♡ 100%" Foreground="{StaticResource AccentGreen}" FontSize="9" Margin="0,1,0,6"/><TextBlock Text="CAN FD" Style="{StaticResource TinyLabel}"/><TextBlock Text="Enabled (2 Mbps)" Style="{StaticResource TinyText}"/></StackPanel></Grid></Grid></Border>
        </Grid>

        <!-- Message list and live monitor -->
        <Grid Grid.Row="2" Margin="8,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,3,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="3. TX MESSAGE LIST" Style="{StaticResource SectionTitle}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="+ Add" Style="{StaticResource TinyButton}" Background="Transparent"/><Button Content="Delete" Style="{StaticResource TinyButton}" Background="Transparent"/><Button Content="Delete All" Style="{StaticResource TinyButton}" Background="Transparent"/><Button Content="Move Up" Style="{StaticResource TinyButton}" Background="Transparent"/><Button Content="Move Down" Style="{StaticResource TinyButton}" Background="Transparent"/></StackPanel></Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Messages}" FontSize="8" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Id}" Width="35"/><DataGridCheckBoxColumn Header="Enable" Width="48" IsReadOnly="True"/><DataGridTextColumn Header="Message Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="CAN ID (Hex)" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="34"/><DataGridTextColumn Header="Cycle Time" Binding="{Binding Cycle}" Width="56"/><DataGridTextColumn Header="Mode" Binding="{Binding Cycle}" Width="52"/><DataGridTextColumn Header="Send Type" Binding="{Binding Cycle}" Width="58"/><DataGridTextColumn Header="Signals" Binding="{Binding Dlc}" Width="48"/><DataGridTextColumn Header="Last Sent" Binding="{Binding Cycle}" Width="74"/><DataGridTemplateColumn Header="Actions" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="▶" Foreground="{StaticResource AccentGreen}" Style="{StaticResource GridText}" Margin="2"/><TextBlock Text="✎" Foreground="{StaticResource AccentCyan}" Style="{StaticResource GridText}" Margin="2"/><TextBlock Text="□" Foreground="{StaticResource TextSecondary}" Style="{StaticResource GridText}" Margin="2"/><TextBlock Text="×" Foreground="{StaticResource AccentRed}" Style="{StaticResource GridText}" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
            </Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="3,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="4. LIVE SIGNAL MONITOR" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="32"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="Search signals..." FontSize="8" Height="20" Margin="0,0,6,0"/><ComboBox Grid.Column="1" Height="20" SelectedIndex="0"><ComboBoxItem Content="All Messages"/></ComboBox><Button Grid.Column="2" Content="Ⅱ" ToolTip="Pause monitor" Style="{StaticResource TinyButton}" Margin="4,0,0,0"/><Button Grid.Column="3" Content="Clear" ToolTip="Clear monitor" Style="{StaticResource TinyButton}" Background="Transparent" Margin="4,0,0,0"/></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding Signals}" FontSize="8" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Signal Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Message" Binding="{Binding StartBit}" Width="55"/><DataGridTextColumn Header="Raw Value" Binding="{Binding Value}" Width="58"/><DataGridTextColumn Header="Physical Value" Binding="{Binding Value}" Width="70"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="36"/><DataGridTemplateColumn Header="Status" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="● Valid" Foreground="{StaticResource AccentGreen}" Style="{StaticResource GridText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Updated" Binding="{Binding Cycle}" Width="72"/></DataGrid.Columns></DataGrid></Grid></Border>
        </Grid>

        <!-- Fault configuration, signal values, execution -->
        <Grid Grid.Row="3" Margin="8,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.45*"/><ColumnDefinition Width=".88*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" BorderBrush="{StaticResource AccentRed}" Margin="0,0,3,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions><TextBlock Text="5. FAULT CONFIGURATION" Style="{StaticResource SectionTitle}"/><TextBlock Grid.Row="1" Text="Selected: EngineData.EngineSpeed" Style="{StaticResource TinyText}"/><Grid Grid.Row="2" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Fault Type" Style="{StaticResource TinyLabel}"/><ComboBox Height="20" SelectedIndex="0"><ComboBoxItem Content="Stuck at Value"/></ComboBox><TextBlock Text="Cycle" Style="{StaticResource TinyLabel}" Margin="0,4,0,0"/><TextBox Text="100 ms" Height="20" FontSize="8"/><TextBlock Text="Repeat" Style="{StaticResource TinyLabel}" Margin="0,4,0,0"/><TextBox Text="0" Height="20" FontSize="8"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Injection Mode" Style="{StaticResource TinyLabel}"/><ComboBox Height="20" SelectedIndex="0"><ComboBoxItem Content="Cyclic"/></ComboBox><TextBlock Text="Duration" Style="{StaticResource TinyLabel}" Margin="0,4,0,0"/><TextBox Text="10 s" Height="20" FontSize="8"/><TextBlock Text="Stop Time" Style="{StaticResource TinyLabel}" Margin="0,4,0,0"/><TextBox Text="0 s" Height="20" FontSize="8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Duration" Style="{StaticResource TinyLabel}"/><TextBox Text="10 s" Height="20" FontSize="8"/><CheckBox Content="Override existing" Foreground="White" FontSize="8" Margin="0,6,0,0" IsChecked="True"/><CheckBox Content="Restore after stop" Foreground="White" FontSize="8" IsChecked="True"/></StackPanel></Grid><Grid Grid.Row="3"><TextBlock Text="Injection is configured but does not transmit until started." Foreground="{StaticResource TextMuted}" FontSize="7" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Content="+ Add to Queue" Style="{StaticResource TinyButton}" HorizontalAlignment="Right" Width="105"/></Grid></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="3,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="6. SIGNAL VALUE CONFIGURATION" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1"><TextBox Text="Search signals..." FontSize="8" Height="20" Width="180"/><CheckBox Content="Show Only Overridden" Foreground="{StaticResource TextSecondary}" FontSize="8" HorizontalAlignment="Right"/></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding Signals}" FontSize="8" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Signal Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Message" Binding="{Binding StartBit}" Width="54"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="34"/><DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="32"/><DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="32"/><DataGridTextColumn Header="Step" Binding="{Binding Factor}" Width="32"/><DataGridTemplateColumn Header="Override" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="✓" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="3,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="46"/><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="7. EXECUTION CONTROL" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="▶  Start Injection" Background="{StaticResource AccentGreen}" Style="{StaticResource TinyButton}" Margin="0,0,3,0"/><Button Grid.Column="1" Content="■  Stop" Background="{StaticResource AccentRed}" Style="{StaticResource TinyButton}" Margin="3,0,0,0"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Ⅱ  Pause" Style="{StaticResource TinyButton}" Background="#B45309" Margin="0,0,3,0"/><Button Grid.Column="1" Content="Clear Queue" Style="{StaticResource TinyButton}" Background="Transparent" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Margin="3,0,0,0"/></Grid><Grid Grid.Row="3" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Queue Status" Style="{StaticResource TinyLabel}"/><TextBlock Text="Idle" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Queue Items" Style="{StaticResource TinyLabel}"/><TextBlock Text="0" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Running" Style="{StaticResource TinyLabel}"/><TextBlock Text="—" Style="{StaticResource TinyText}"/></StackPanel></Grid></Grid></Border>
        </Grid>

        <!-- Log and bus health -->
        <Grid Grid.Row="4" Margin="8,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,3,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="8. LOG / OUTPUT" Style="{StaticResource SectionTitle}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><ComboBox SelectedIndex="0" Width="82" Height="20"><ComboBoxItem Content="All Levels"/></ComboBox><Button Content="Clear" Style="{StaticResource TinyButton}" Background="Transparent"/><Button Content="Export" Style="{StaticResource TinyButton}" Background="Transparent"/></StackPanel></Grid><Border Grid.Row="1" Background="{StaticResource LogBg}" Padding="7"><TextBlock FontFamily="Consolas" FontSize="8" Foreground="{StaticResource TextSecondary}" Text="14:30:25.123  [INFO]  Connected to CANoe on channel CAN 1 (500 kbps / 2 Mbps FD)&#x0a;14:30:25.456  [INFO]  DBC loaded: Vehicle_Network.dbc (Messages: 256, Nodes: 28, Signals: 1024)&#x0a;14:30:26.001  [INFO]  Added fault to queue: EngineData.EngineSpeed - Stuck at Value (0x0000)&#x0a;14:30:26.210  [INFO]  Injection started&#x0a;14:30:26.345  [DEBUG] Injecting 0x100 - EngineData.EngineSpeed = 0x0000&#x0a;14:30:31.002  [INFO]  Fault executed: 0x102 - BrakeStatus.BrakeApplied - Bit Flip (Bit 0)"/></Border></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="3,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="9. BUS MONITOR (HEALTH)" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions><Canvas Margin="8,6"><Line X1="0" Y1="26" X2="580" Y2="26" Stroke="{StaticResource CardBorder}"/><Polyline Points="0,26 25,23 50,25 75,21 100,25 125,27 150,24 175,25 200,21 225,23 250,26 275,25 300,22 325,25 350,27 375,23 400,25 425,21 450,23 475,26 500,24 525,25 550,22" Stroke="{StaticResource AccentGreen}" StrokeThickness="1.5"/></Canvas><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Bus Load" Style="{StaticResource TinyLabel}"/><TextBlock Text="24.7%" Foreground="{StaticResource AccentGreen}" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Error Frames" Style="{StaticResource TinyLabel}"/><TextBlock Text="0" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Lost Frames" Style="{StaticResource TinyLabel}"/><TextBlock Text="0" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Warning" Style="{StaticResource TinyLabel}"/><TextBlock Text="1" Foreground="{StaticResource AccentYellow}" FontWeight="Bold"/></StackPanel></Grid></Grid></Grid></Border>
        </Grid>

        <Border Grid.Row="5" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"><Grid Margin="10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="● Ready" Foreground="{StaticResource AccentGreen}" FontSize="9"/><TextBlock Text="   Tx: 12,345 msgs/s     Rx: 12,312 msgs/s     Errors: 0     Bus Load: 24.7%" Foreground="{StaticResource TextSecondary}" FontSize="8"/></StackPanel><TextBlock Text="Time: 2025-05-20 14:30:31     Session: 00:02:15" Foreground="{StaticResource TextSecondary}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
</Window>
