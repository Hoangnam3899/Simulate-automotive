<Window x:Class="Simulate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFI - Automotive Fault Injector"
        Icon="Assets/app.ico"
        Width="1380" Height="800" MinWidth="1100" MinHeight="650"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="8"/>
        </Style>
        <Style x:Key="TinyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style x:Key="GridText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="LedStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Connection.IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LedTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="Disconnected"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Connection.IsConnected}" Value="True">
                    <Setter Property="Text" Value="Connected"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1.15*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="10,0,4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="0,0,9,0"><TextBlock Text="AFI" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="13"/></Border>
                    <StackPanel><TextBlock Text="{DynamicResource Loc_App_Title}" Foreground="White" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{DynamicResource Loc_App_Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="8"/></StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Content="?" ToolTip="{DynamicResource Loc_Tooltip_Help}" Style="{StaticResource WinBtnStyle}"/>
                    <Button Content="&#x2699;" ToolTip="{DynamicResource Loc_Tooltip_Settings}" Style="{StaticResource WinBtnStyle}" Click="BtnSettings_Click">
                        <Button.ContextMenu>
                            <ContextMenu BorderThickness="0" Background="Transparent" HasDropShadow="True">
                                <ContextMenu.Resources>
                                    <Style TargetType="Separator">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Separator">
                                                    <Border Background="#253550" Height="1" Margin="8,4"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="LangMenuItemStyle" TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="10,6" Margin="4,2">
                                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="#141E30" BorderBrush="#334B73" BorderThickness="1.5" CornerRadius="8" Padding="4,5" MinWidth="220">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.55" Direction="270" ShadowDepth="4"/>
                                            </Border.Effect>
                                            <StackPanel IsItemsHost="True"/>
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>

                                <!-- Header Title -->
                                <MenuItem IsEnabled="False">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border Padding="10,6,10,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="🌐 " FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource Loc_Lang_MenuTitle}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>

                                <Separator/>

                                <!-- 5 Language Items -->
                                <MenuItem Style="{StaticResource LangMenuItemStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="Vietnamese">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🇻🇳" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Tiếng Việt (Vietnamese)" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="13" Margin="14,0,2,0" VerticalAlignment="Center" Visibility="{Binding IsVietnamese, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Style="{StaticResource LangMenuItemStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="English">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🇬🇧" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="English (English)" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="13" Margin="14,0,2,0" VerticalAlignment="Center" Visibility="{Binding IsEnglish, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Style="{StaticResource LangMenuItemStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="Korean">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🇰🇷" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="한국어 (Korean)" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="13" Margin="14,0,2,0" VerticalAlignment="Center" Visibility="{Binding IsKorean, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Style="{StaticResource LangMenuItemStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="Japanese">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🇯🇵" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="日本語 (Japanese)" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="13" Margin="14,0,2,0" VerticalAlignment="Center" Visibility="{Binding IsJapanese, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Style="{StaticResource LangMenuItemStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="Chinese">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🇨🇳" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="简体中文 (Chinese)" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="13" Margin="14,0,2,0" VerticalAlignment="Center" Visibility="{Binding IsChinese, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="-" ToolTip="{DynamicResource Loc_Tooltip_Minimize}" Style="{StaticResource WinBtnStyle}" Click="BtnMinimize_Click"/>
                    <Button Content="&#x25A1;" ToolTip="{DynamicResource Loc_Tooltip_Maximize}" Style="{StaticResource WinBtnStyle}" Click="BtnMaximize_Click"/>
                    <Button Content="x" ToolTip="{DynamicResource Loc_Tooltip_Close}" Style="{StaticResource WinCloseBtnStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top row: connection, DBC, overview -->
        <Grid Grid.Row="1" Margin="8,4,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,3,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="{DynamicResource Loc_Sec_Connection}" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="6" Height="6" Style="{StaticResource LedStyle}" Margin="0,0,4,0"/><TextBlock Style="{StaticResource LedTextStyle}"/></StackPanel></Grid>
                <Grid Grid.Row="1" Margin="0,7,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource Loc_Conn_Interface}" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableInterfaces}" SelectedItem="{Binding Connection.SelectedInterface}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22" DisplayMemberPath="Name"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="2,0"><TextBlock Text="{DynamicResource Loc_Conn_TxChannel}" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableChannels}" SelectedItem="{Binding Connection.SelectedTx}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22" DisplayMemberPath="Name"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="2,0,0,0"><TextBlock Text="{DynamicResource Loc_Conn_RxChannel}" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableChannels}" SelectedItem="{Binding Connection.SelectedRx}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22" DisplayMemberPath="Name"/></StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><TextBlock Text="{DynamicResource Loc_Conn_CanFd}" Style="{StaticResource TinyLabel}" Margin="0,0,7,4"/><CheckBox IsChecked="{Binding Connection.IsCanFdEnabled}" IsEnabled="{Binding Connection.CanEditConnectionSettings}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="2,0"><TextBlock Text="{DynamicResource Loc_Conn_BaudrateTx}" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableBaudrates}" SelectedItem="{Binding Connection.BaudrateTx}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="2,0,0,0"><TextBlock Text="{DynamicResource Loc_Conn_BaudrateRx}" Style="{StaticResource TinyLabel}"/><ComboBox ItemsSource="{Binding Connection.AvailableBaudrates}" SelectedItem="{Binding Connection.BaudrateRx}" IsEnabled="{Binding Connection.CanEditConnectionSettings}" Height="22"/></StackPanel>
                </Grid>
                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{DynamicResource Loc_Conn_BtnDisconnect}" Command="{Binding Connection.DisconnectCommand}" Style="{StaticResource TinyButton}" Margin="0,0,3,0"/><Button Grid.Column="1" Content="{DynamicResource Loc_Conn_BtnConnect}" Command="{Binding Connection.ConnectCommand}" Style="{StaticResource TinyButton}" Margin="3,0"/><Button Grid.Column="2" Content="{DynamicResource Loc_Conn_BtnRefresh}" Command="{Binding Connection.RefreshInterfacesCommand}" ToolTip="{DynamicResource Loc_Conn_Tooltip_Refresh}" Style="{StaticResource TinyButton}" Background="Transparent" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Foreground="{StaticResource AccentCyan}" Margin="3,0,0,0"/></Grid>
            </Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="3,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Loc_Sec_Dbc}" Style="{StaticResource SectionTitle}"/><StackPanel Grid.Row="1" Margin="0,7,0,3"><TextBlock Text="{DynamicResource Loc_Dbc_LoadedFile}" Style="{StaticResource TinyLabel}"/><Border Background="{StaticResource LogBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="2" Padding="7,4"><Grid><TextBlock Text="{Binding Dbc.LoadedFileNameDisplay}" Style="{StaticResource TinyText}" FontWeight="SemiBold"/><TextBlock Text="&#x2713;" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right" Visibility="{Binding Dbc.CheckmarkVisibility}"/></Grid></Border></StackPanel>
                <Grid Grid.Row="2" Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Loc_Dbc_Messages}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding Dbc.MessageCount}" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Loc_Dbc_Nodes}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding Dbc.NodeCount}" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Loc_Dbc_Signals}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding Dbc.SignalCount}" Foreground="White" FontSize="14" FontWeight="Bold"/></StackPanel></Grid>
                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="{DynamicResource Loc_Dbc_BtnLoad}" Command="{Binding Dbc.LoadDbcCommand}" IsEnabled="{Binding Dbc.CanLoadDbc}" Style="{StaticResource TinyButton}" Margin="0,0,3,0"/><Button Grid.Column="1" Content="{DynamicResource Loc_Dbc_BtnUnload}" Command="{Binding Dbc.UnloadDbcCommand}" IsEnabled="{Binding Dbc.CanUnloadDbc}" Style="{StaticResource TinyButton}" Background="Transparent" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Foreground="{StaticResource TextSecondary}" Margin="3,0,0,0"/></Grid>
            </Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="3,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc_Sec_Overview}" Style="{StaticResource SectionTitle}"/>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_Overview_Connection}" Style="{StaticResource TinyLabel}"/>
                            <TextBlock Text="{Binding StatusOverview.ConnectionText, Converter={StaticResource StatusToLocalizedConverter}}" Foreground="{Binding StatusOverview.ConnectionColor}" FontSize="9" Margin="0,1,0,6"/>
                            <TextBlock Text="{DynamicResource Loc_Overview_Driver}" Style="{StaticResource TinyLabel}"/>
                            <TextBlock Text="{Binding StatusOverview.DriverText, Converter={StaticResource StatusToLocalizedConverter}}" Style="{StaticResource TinyText}" Margin="0,1,0,6" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{DynamicResource Loc_Overview_BusState}" Style="{StaticResource TinyLabel}"/>
                            <TextBlock Text="{Binding StatusOverview.BusStateText, Converter={StaticResource StatusToLocalizedConverter}}" Foreground="{Binding StatusOverview.BusStateColor}" FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Loc_Overview_Dbc}" Style="{StaticResource TinyLabel}"/>
                            <TextBlock Text="{Binding StatusOverview.DbcText, Converter={StaticResource StatusToLocalizedConverter}}" Style="{StaticResource TinyText}" Margin="0,1,0,6" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{DynamicResource Loc_Overview_BusHealth}" Style="{StaticResource TinyLabel}"/>
                            <TextBlock Text="{Binding StatusOverview.BusHealthText, Converter={StaticResource StatusToLocalizedConverter}}" Foreground="{Binding StatusOverview.BusHealthColor}" FontSize="9" Margin="0,1,0,6"/>
                            <TextBlock Text="{DynamicResource Loc_Overview_CanFd}" Style="{StaticResource TinyLabel}"/>
                            <TextBlock Text="{Binding StatusOverview.CanFdText, Converter={StaticResource StatusToLocalizedConverter}}" Style="{StaticResource TinyText}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Message list and live monitor -->
        <Grid Grid.Row="2" Margin="8,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,3,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Loc_Sec_TxList}" Style="{StaticResource SectionTitle}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="{DynamicResource Loc_Tx_BtnAdd}" Command="{Binding Simulation.AddMessagesCommand}" Style="{StaticResource TinyButton}" Background="Transparent"/><Button Content="{DynamicResource Loc_Tx_BtnDelete}" Command="{Binding Simulation.DeleteMessageCommand}" Style="{StaticResource TinyButton}" Background="Transparent"/><Button Content="{DynamicResource Loc_Tx_BtnDeleteAll}" Command="{Binding Simulation.DeleteAllMessagesCommand}" Style="{StaticResource TinyButton}" Background="Transparent"/><Button Content="{DynamicResource Loc_Tx_BtnMoveUp}" Command="{Binding Simulation.MoveUpCommand}" Style="{StaticResource TinyButton}" Background="Transparent"/><Button Content="{DynamicResource Loc_Tx_BtnMoveDown}" Command="{Binding Simulation.MoveDownCommand}" Style="{StaticResource TinyButton}" Background="Transparent"/></StackPanel></Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Messages}" SelectedItem="{Binding Simulation.SelectedMessage, Mode=TwoWay}" FontSize="8" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding DisplayIndex}" Width="35"/><DataGridCheckBoxColumn Header="Enable" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="48"/><DataGridTextColumn Header="Message Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="CAN ID (Hex)" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="34"/><DataGridTextColumn Header="Cycle Time" Binding="{Binding Cycle}" Width="56"/><DataGridTextColumn Header="Mode" Binding="{Binding GatewayMode}" Width="52"/><DataGridTextColumn Header="Send Type" Binding="{Binding SendType}" Width="58"/><DataGridTextColumn Header="Signals" Binding="{Binding SignalCount}" Width="48"/><DataGridTextColumn Header="Last Sent" Binding="{Binding LastSent}" Width="74"/><DataGridTemplateColumn Header="Actions" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="▶" Foreground="{StaticResource AccentGreen}" Style="{StaticResource GridText}" Margin="2"/><TextBlock Text="✎" Foreground="{StaticResource AccentCyan}" Style="{StaticResource GridText}" Margin="2"/><TextBlock Text="□" Foreground="{StaticResource TextSecondary}" Style="{StaticResource GridText}" Margin="2"/><TextBlock Text="×" Foreground="{StaticResource AccentRed}" Style="{StaticResource GridText}" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
            </Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="3,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Loc_Sec_LiveMonitor}" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="32"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding Simulation.SignalSearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="8" Height="20" Margin="0,0,6,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Simulation.AvailableSignalMessageFilters}" SelectedItem="{Binding Simulation.SelectedSignalMessageFilter}" Height="20"/><Button Grid.Column="2" Content="{Binding Simulation.PauseMonitorButtonContent}" Command="{Binding Simulation.TogglePauseMonitorCommand}" ToolTip="Pause / Resume monitor" Style="{StaticResource TinyButton}" Margin="4,0,0,0"/><Button Grid.Column="3" Content="{DynamicResource Loc_Monitor_BtnClear}" Command="{Binding Simulation.ClearSignalMonitorCommand}" ToolTip="Clear monitor values" Style="{StaticResource TinyButton}" Background="Transparent" Margin="4,0,0,0"/></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding Simulation.FilteredSignals}" SelectedItem="{Binding Simulation.SelectedSignal, Mode=TwoWay}" FontSize="8" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Signal Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="75"/><DataGridTextColumn Header="Raw Value" Binding="{Binding RawValue}" Width="65"/><DataGridTextColumn Header="Physical Value" Binding="{Binding PhysicalValueDisplay}" Width="80"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="36"/><DataGridTemplateColumn Header="Status" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText, Converter={StaticResource StatusToLocalizedConverter}}" Foreground="{Binding StatusColor}" Style="{StaticResource GridText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Updated" Binding="{Binding LastUpdated}" Width="72"/></DataGrid.Columns></DataGrid></Grid></Border>
        </Grid>

        <!-- Fault configuration, signal values, execution -->
        <!-- Fault configuration, signal values, execution -->
        <Grid Grid.Row="3" Margin="8,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.0*"/><ColumnDefinition Width="1.72*"/><ColumnDefinition Width=".72*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" BorderBrush="{StaticResource AccentRed}" Margin="0,0,3,0" Padding="8,6"><Border.Resources><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="22"/><Setter Property="FontSize" Value="9.5"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/><Setter Property="Background" Value="#080C16"/></Trigger></Style.Triggers></Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="22"/><Setter Property="FontSize" Value="9.5"/></Style><Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource TinyLabel}"><Setter Property="FontSize" Value="8.5"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Margin" Value="0,0,0,1"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers></Style></Border.Resources><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Loc_Sec_FaultConfig}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding FaultConfig.SelectedSignalDisplay}" Foreground="{StaticResource AccentCyan}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190"/></Grid><Grid Grid.Row="1" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,3,0"><TextBlock Text="{DynamicResource Loc_Fault_Type}" Style="{StaticResource FormLabel}" ToolTip="Kiểu can thiệp lỗi vào tín hiệu (Signal Override, Stuck, Bit Flip, Offset...)"/><ComboBox ItemsSource="{Binding FaultConfig.AvailableFaultTypes}" SelectedItem="{Binding FaultConfig.SelectedFaultType}" ToolTip="Chọn kiểu can thiệp lỗi"/><StackPanel IsEnabled="{Binding FaultConfig.IsCycleEnabled}" Margin="0,3,0,0"><TextBlock Text="{DynamicResource Loc_Fault_Cycle}" Style="{StaticResource FormLabel}" ToolTip="Khoảng thời gian giữa 2 lần phát liên tiếp (ms)"/><TextBox Text="{Binding FaultConfig.CycleTimeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Chu kỳ lặp lại (ms)"/></StackPanel><StackPanel IsEnabled="{Binding FaultConfig.IsRepeatEnabled}" Margin="0,3,0,0"><TextBlock Text="{DynamicResource Loc_Fault_Repeat}" Style="{StaticResource FormLabel}" ToolTip="Số lần lặp lại (0 = phát liên tục không giới hạn)"/><TextBox Text="{Binding FaultConfig.RepeatCountText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Số lần lặp lại (0 = liên tục)"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Margin="3,0"><TextBlock Text="{DynamicResource Loc_Fault_Mode}" Style="{StaticResource FormLabel}" ToolTip="Chế độ phát (Cyclic, One-Shot, Event, Sequence)"/><ComboBox ItemsSource="{Binding FaultConfig.AvailableInjectionModes}" SelectedItem="{Binding FaultConfig.SelectedInjectionMode}" ToolTip="Chọn chế độ phát"/><StackPanel IsEnabled="{Binding FaultConfig.IsDurationEnabled}" Margin="0,3,0,0"><TextBlock Text="{DynamicResource Loc_Fault_Duration}" Style="{StaticResource FormLabel}" ToolTip="Thời lượng duy trì lỗi trước khi tự động kết thúc"/><TextBox Text="{Binding FaultConfig.DurationText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Thời lượng tiêm lỗi (s/ms)"/></StackPanel><StackPanel IsEnabled="{Binding FaultConfig.IsDelayEnabled}" Margin="0,3,0,0"><TextBlock Text="{DynamicResource Loc_Fault_Delay}" Style="{StaticResource FormLabel}" ToolTip="Thời gian chờ trước khi bắt đầu phát/tiêm lỗi (ms)"/><TextBox Text="{Binding FaultConfig.StartDelayText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Thời gian trễ khởi đầu (ms)"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Margin="3,0,0,0"><TextBlock Text="{DynamicResource Loc_Fault_OverrideControl}" Style="{StaticResource FormLabel}" ToolTip="Giá trị can thiệp được cấu hình và quản lý tại Bảng 6 (Signal Value Configuration)"/><TextBlock Text="{DynamicResource Loc_Fault_ValInPanel6}" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,2,0,0"/><CheckBox Content="{DynamicResource Loc_Fault_OverrideExisting}" IsChecked="{Binding FaultConfig.IsOverrideExisting}" ToolTip="Bóc tách gói tin live từ RX, ghi đè tín hiệu trước khi chuyển tiếp sang TX" Foreground="White" FontSize="8.5" Margin="0,8,0,0"/><CheckBox Content="{DynamicResource Loc_Fault_RestoreAfterStop}" IsChecked="{Binding FaultConfig.IsRestoreAfterStop}" ToolTip="Tự động khôi phục giá trị gốc của ECU khi bấm Stop" Foreground="White" FontSize="8.5" Margin="0,5,0,0"/></StackPanel></Grid><Grid Grid.Row="2" Margin="0,3,0,0"><TextBlock Text="{Binding FaultConfig.CombinedGuideText}" Foreground="{StaticResource TextSecondary}" FontSize="7.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,108,0"/><Button Content="{DynamicResource Loc_Fault_BtnAddToQueue}" Command="{Binding FaultConfig.AddToQueueCommand}" Visibility="{Binding FaultConfig.AddToQueueVisibility}" Style="{StaticResource TinyButton}" Height="23" FontSize="8.5" HorizontalAlignment="Right" Width="105"/></Grid></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="3,0" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="{DynamicResource Loc_Sec_SignalVal}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Simulation.SelectedSignalE2eText}" Foreground="{Binding Simulation.SelectedSignalE2eColor}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Trạng thái bảo vệ End-to-End (CRC8 + Alive Counter) của Message chứa tín hiệu này"/>
                            <CheckBox Content="{DynamicResource Loc_Sig_E2EProtection}" IsChecked="{Binding Simulation.IsSelectedSignalE2eChecked, Mode=TwoWay}" IsEnabled="{Binding Simulation.CanToggleSelectedSignalE2e}" Foreground="White" FontSize="8" VerticalAlignment="Center" ToolTip="Bật/Tắt bảo vệ E2E cho Message này. Nếu DBC không tự nhận diện được, hệ thống sẽ dùng cấu hình chuẩn dự phòng."/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,2,0,4">
                        <TextBox Text="{Binding Simulation.SignalValueSearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="9.5" Height="22" Width="170" HorizontalAlignment="Left" ToolTip="Tìm kiếm tín hiệu theo tên hoặc message"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{DynamicResource Loc_Sig_BtnClearAll}" Command="{Binding Simulation.ClearAllOverridesCommand}" Style="{StaticResource TinyButton}" Height="20" FontSize="8" Padding="6,1" Margin="0,0,8,0" ToolTip="Hủy toàn bộ tín hiệu đang ghi đè"/>
                            <CheckBox Content="{DynamicResource Loc_Sig_ShowOverridden}" IsChecked="{Binding Simulation.ShowOnlyOverridden}" Foreground="{StaticResource TextSecondary}" FontSize="8.5" VerticalAlignment="Center" ToolTip="Chỉ hiển thị các tín hiệu đang được ghi đè (Override)"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Simulation.FilteredValueSignals}" SelectedItem="{Binding Simulation.SelectedSignal, Mode=TwoWay}" FontSize="9.5" RowHeight="24" CanUserSortColumns="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="FontSize" Value="8.5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Signal Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" IsReadOnly="True" Width="80"/>
                            <DataGridTemplateColumn Header="Value" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Border CornerRadius="2" Padding="2,1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                                                    <Setter Property="Background" Value="#FFFFFF"/>
                                                                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsValueValid}" Value="False">
                                                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Grid.Column="0" Text="{Binding PhysicalValueInput, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" Padding="2,0" VerticalAlignment="Center" FontSize="9.5" ToolTip="{Binding ValidationToolTip}">
                                                                            <TextBox.Style>
                                                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                                    <Setter Property="Foreground" Value="{Binding ValueColor}"/>
                                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                                    <Setter Property="CaretBrush" Value="{StaticResource AccentCyan}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                                                            <Setter Property="Foreground" Value="#000000"/>
                                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                            <Setter Property="CaretBrush" Value="#000000"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsValueValid}" Value="False">
                                                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                                            <Setter Property="CaretBrush" Value="#DC2626"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBox.Style>
                                                                        </TextBox>
                                                                        <TextBlock Grid.Column="1" Text="⚠️" Foreground="#EF4444" FontSize="9" VerticalAlignment="Center" Margin="2,0,2,0" ToolTip="{Binding ValidationToolTip}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsValueValid}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasValueDescriptions}" Value="True">
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <Border CornerRadius="2">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsValueValid}" Value="False">
                                                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <ComboBox ItemsSource="{Binding AvailableValueDescriptions}" SelectedItem="{Binding PhysicalValueInput, UpdateSourceTrigger=PropertyChanged}" BorderThickness="1" Padding="3,1" Height="22" VerticalAlignment="Center" FontSize="9" ToolTip="{Binding ValidationToolTip}">
                                                                                <ComboBox.Style>
                                                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                                        <Setter Property="Background" Value="#1E293B"/>
                                                                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                                                                        <Setter Property="BorderBrush" Value="#334155"/>
                                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                                                                <Setter Property="Foreground" Value="#000000"/>
                                                                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsValueValid}" Value="False">
                                                                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </ComboBox.Style>
                                                                            </ComboBox>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="40"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding Min}" IsReadOnly="True" Width="44"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding Max}" IsReadOnly="True" Width="46"/>
                            <DataGridTextColumn Header="Step" Binding="{Binding Factor}" IsReadOnly="True" Width="40"/>
                            <DataGridTemplateColumn Header="Override" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsOverridden, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Bật / tắt ghi đè giá trị tín hiệu này"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="3,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="46"/><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Loc_Sec_ExecControl}" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="{DynamicResource Loc_Exec_BtnStartInj}" Command="{Binding Simulation.StartInjectionCommand}" Background="{StaticResource AccentGreen}" Style="{StaticResource TinyButton}" Margin="0,0,3,0"/><Button Grid.Column="1" Content="{DynamicResource Loc_Exec_BtnStop}" Command="{Binding Simulation.StopInjectionCommand}" Background="{StaticResource AccentRed}" Style="{StaticResource TinyButton}" Margin="3,0,0,0"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="{Binding Simulation.PauseInjectionButtonContent}" Command="{Binding Simulation.TogglePauseInjectionCommand}" Style="{StaticResource TinyButton}" Background="#B45309" Margin="0,0,3,0"/><Button Grid.Column="1" Content="{DynamicResource Loc_Fault_BtnClearQueue}" Command="{Binding Simulation.ClearQueueCommand}" Style="{StaticResource TinyButton}" Background="Transparent" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Margin="3,0,0,0"/></Grid><Grid Grid.Row="3" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Loc_Exec_QueueStatus}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding Simulation.QueueStatusText, Converter={StaticResource StatusToLocalizedConverter}}" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Loc_Exec_QueueItems}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding Simulation.QueueItemsDisplay}" Style="{StaticResource TinyText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Loc_Exec_Running}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding Simulation.RunningFaultDisplay}" Style="{StaticResource TinyText}"/></StackPanel></Grid></Grid></Border>
        </Grid>

        <!-- Log and bus health -->
        <Grid Grid.Row="4" Margin="8,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,3,0" Padding="6,4"><Grid><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Loc_Sec_DiagLog}" Style="{StaticResource SectionTitle}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><ComboBox ItemsSource="{Binding Logging.AvailableLevels}" SelectedItem="{Binding Logging.SelectedLevel}" Width="76" Height="18" FontSize="8"/><Button Content="{DynamicResource Loc_Log_BtnClear}" Command="{Binding Logging.ClearCommand}" Style="{StaticResource TinyButton}" Height="18" FontSize="8" Background="Transparent" Margin="2,0"/><Button Content="{DynamicResource Loc_Log_BtnExport}" Command="{Binding Logging.ExportCommand}" Style="{StaticResource TinyButton}" Height="18" FontSize="8" Background="Transparent"/></StackPanel></Grid><Border Grid.Row="1" Background="{StaticResource LogBg}" Padding="5,2" Margin="0,2,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock FontFamily="Consolas" FontSize="7.5" Foreground="{StaticResource TextSecondary}" Text="{Binding Logging.FormattedLogText}"/></ScrollViewer></Border></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="3,0,0,0" Padding="6,4"><Grid><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Loc_Sec_BusHealth}" Style="{StaticResource SectionTitle}" ToolTip="{Binding BusHealth.HealthStatusText}"/><Grid Grid.Row="1" Margin="0,2,0,0"><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="22"/></Grid.RowDefinitions><Canvas Margin="4,1"><Line X1="0" Y1="9" X2="580" Y2="9" Stroke="{StaticResource CardBorder}"/><Polyline Points="0,9 25,6 50,8 75,4 100,8 125,10 150,7 175,8 200,4 225,6 250,9 275,8 300,5 325,8 350,10 375,6 400,8 425,4 450,6 475,9 500,7 525,8 550,5" Stroke="{Binding BusHealth.HealthStrokeColor}" StrokeThickness="1.5"/></Canvas><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Loc_Health_BusLoad}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding BusHealth.BusLoadDisplay}" Foreground="{Binding BusHealth.BusLoadColor}" FontWeight="Bold" FontSize="8.5" ToolTip="{Binding BusHealth.BusLoadToolTip}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Loc_Health_Errors}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding BusHealth.ErrorCountDisplay}" Foreground="{Binding BusHealth.ErrorColor}" FontSize="8.5" ToolTip="{Binding BusHealth.ErrorToolTip}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Loc_Health_Lost}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding BusHealth.LostCountDisplay}" Foreground="{Binding BusHealth.LostColor}" FontSize="8.5" ToolTip="{Binding BusHealth.LostToolTip}"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Loc_Health_Warnings}" Style="{StaticResource TinyLabel}"/><TextBlock Text="{Binding BusHealth.WarningCountDisplay}" Foreground="{Binding BusHealth.WarningColor}" FontWeight="Bold" FontSize="8.5" ToolTip="{Binding BusHealth.WarningToolTip}"/></StackPanel></Grid></Grid></Grid></Border>
        </Grid>

        <Border Grid.Row="5" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <!-- Left: Telemetry & Status Badges -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Status Badge -->
                    <Border Background="{Binding Simulation.SimulationStatusBg}" BorderBrush="{Binding Simulation.SimulationStatusColor}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Fill="{Binding Simulation.SimulationStatusDotColor}" Width="6" Height="6" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Simulation.SimulationStatusText, Converter={StaticResource StatusToLocalizedConverter}}" Foreground="{Binding Simulation.SimulationStatusColor}" FontWeight="Bold" FontSize="8.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Elapsed Badge -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱ " Foreground="#8B949E" FontSize="8.5"/>
                            <TextBlock Text="{Binding Simulation.ElapsedDisplay}" Foreground="#E6EDF3" FontFamily="Consolas" FontWeight="SemiBold" FontSize="8.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Sent Frames Badge -->
                    <Border Background="#0D2818" BorderBrush="#1B5E20" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TX: " Foreground="#81C784" FontSize="8" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Simulation.SentDisplay}" Foreground="#00E676" FontFamily="Consolas" FontWeight="Bold" FontSize="8.5"/>
                        </StackPanel>
                    </Border>

                    <!-- RX Frames Badge -->
                    <Border Background="#0A192F" BorderBrush="#0D47A1" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RX: " Foreground="#64B5F6" FontSize="8" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Simulation.RxDisplay}" Foreground="#00B0FF" FontFamily="Consolas" FontWeight="Bold" FontSize="8.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Injected Frames Badge -->
                    <Border Background="#2A1B0A" BorderBrush="#B26A00" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="INJ: " Foreground="#FFB74D" FontSize="8" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Simulation.InjectedDisplay}" Foreground="#FFB300" FontFamily="Consolas" FontWeight="Bold" FontSize="8.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Latency Badge -->
                    <Border Background="#1A1D24" BorderBrush="#384252" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LAT: " Foreground="#94A3B8" FontSize="8" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Simulation.LatencyDisplay}" Foreground="#E2E8F0" FontFamily="Consolas" FontSize="8.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Reset Counters Button -->
                    <Button Content="{DynamicResource Loc_Foot_Reset}" Command="{Binding Simulation.ResetCountersCommand}" Style="{StaticResource TinyButton}" Height="18" FontSize="8" Padding="5,0" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Margin="2,0,0,0"/>
                </StackPanel>

                <!-- Right: Bus Telemetry Metrics -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Tx: " Foreground="{StaticResource TextMuted}" FontSize="8"/>
                        <TextBlock Text="{Binding BusHealth.TxRateDisplay}" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="8.5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Rx: " Foreground="{StaticResource TextMuted}" FontSize="8"/>
                        <TextBlock Text="{Binding BusHealth.RxRateDisplay}" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="8.5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Bus Load: " Foreground="{StaticResource TextMuted}" FontSize="8"/>
                        <TextBlock Text="{Binding BusHealth.BusLoadDisplay}" Foreground="{Binding BusHealth.BusLoadColor}" FontFamily="Consolas" FontWeight="Bold" FontSize="8.5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Errors: " Foreground="{StaticResource TextMuted}" FontSize="8"/>
                        <TextBlock Text="{Binding BusHealth.ErrorCountDisplay}" Foreground="{Binding BusHealth.ErrorColor}" FontFamily="Consolas" FontSize="8.5"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
