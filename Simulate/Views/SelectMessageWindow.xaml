<Window x:Class="Simulate.Views.SelectMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Messages from DBC"
        Width="680" Height="500" MinWidth="520" MinHeight="360"
        Background="#141D2E"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="DlgBg" Color="#141D2E"/>
        <SolidColorBrush x:Key="DlgCardBg" Color="#1C273C"/>
        <SolidColorBrush x:Key="DlgAltRowBg" Color="#23314B"/>
        <SolidColorBrush x:Key="DlgBorder" Color="#334769"/>
        <SolidColorBrush x:Key="DlgHeaderBg" Color="#253550"/>
        <SolidColorBrush x:Key="DlgInputBg" Color="#1E2B42"/>
        <SolidColorBrush x:Key="DlgTextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="DlgTextSecondary" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="DlgTextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="DlgAccentCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="DlgAccentBlue" Color="#2563EB"/>

        <Style x:Key="DialogTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DlgAccentCyan}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{StaticResource DlgCardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource DlgTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource DlgHeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource DlgAccentCyan}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Foreground" Value="{StaticResource DlgTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" Background="{StaticResource DlgBg}" CornerRadius="4">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Select DBC Messages to Add to TX List" Style="{StaticResource DialogTitle}"/>
                <Button Content="✕" Click="BtnCancel_Click" HorizontalAlignment="Right"
                        Style="{StaticResource DialogButton}" Background="Transparent" Width="26" Height="22"
                        Foreground="{StaticResource DlgTextSecondary}"/>
            </Grid>

            <!-- Search & Quick Selection -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"
                         FontSize="10" Height="26" Padding="8,3"
                         Background="{StaticResource DlgInputBg}" Foreground="{StaticResource DlgTextPrimary}"
                         BorderBrush="{StaticResource DlgBorder}" VerticalContentAlignment="Center"/>
                <TextBlock Text="Search by Name or CAN ID (Hex)..." IsHitTestVisible="False"
                           Foreground="{StaticResource DlgTextMuted}" FontSize="9.5" VerticalAlignment="Center"
                           Margin="10,0,0,0" Visibility="{Binding ElementName=TxtSearch, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                <Button Grid.Column="1" Content="Select All" Click="BtnSelectAll_Click"
                        Style="{StaticResource DialogButton}" Margin="6,0,0,0"/>
                <Button Grid.Column="2" Content="Deselect All" Click="BtnDeselectAll_Click"
                        Style="{StaticResource DialogButton}" Background="Transparent" Margin="4,0,0,0"/>
            </Grid>

            <!-- Messages DataGrid -->
            <DataGrid Grid.Row="2" x:Name="DgMessages"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="True" HeadersVisibility="Column"
                      Background="{StaticResource DlgCardBg}" Foreground="{StaticResource DlgTextPrimary}"
                      BorderBrush="{StaticResource DlgBorder}" BorderThickness="1"
                      RowBackground="{StaticResource DlgCardBg}" AlternatingRowBackground="{StaticResource DlgAltRowBg}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource DlgBorder}"
                      FontSize="9.5" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                    <DataGridTextColumn Header="CAN ID (Hex)" Binding="{Binding FormattedId}" IsReadOnly="True" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DlgAccentCyan}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Message Name" Binding="{Binding Name}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DlgTextPrimary}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DLC" Binding="{Binding PayloadLength}" IsReadOnly="True" Width="48">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DlgTextSecondary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Signals" Binding="{Binding SignalCount}" IsReadOnly="True" Width="58">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DlgTextSecondary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Transmitter" Binding="{Binding Transmitter}" IsReadOnly="True" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DlgTextSecondary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bottom Actions -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="TxtStatus" Text="0 messages selected"
                           Foreground="{StaticResource DlgTextSecondary}" FontSize="9.5" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="BtnCancel_Click"
                            Style="{StaticResource DialogButton}" Background="Transparent"
                            BorderBrush="{StaticResource DlgBorder}" Width="80" Margin="0,0,8,0"/>
                    <Button Content="Add Selected" Click="BtnAdd_Click"
                            Style="{StaticResource DialogButton}" Background="{StaticResource DlgAccentBlue}"
                            Foreground="White" FontWeight="SemiBold" Width="105"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
