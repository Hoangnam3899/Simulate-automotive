<Window x:Class="Simulate.Views.LicenseLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Simulate.ViewModels"
        mc:Ignorable="d"
        Title="Kích Hoạt Bản Quyền"
        Width="560" Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Nút Action Viền Nhạt (Sao chép / Dán) -->
        <Style x:Key="OutlineActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Primary (Kích hoạt) -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006CBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Khung chính với đổ bóng mềm mại -->
    <Border Margin="10"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A"
                              BlurRadius="18"
                              Opacity="0.18"
                              Direction="270"
                              ShadowDepth="4"/>
        </Border.Effect>

        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Machine ID Card -->
                <RowDefinition Height="Auto"/> <!-- License Key Card -->
                <RowDefinition Height="*"/>    <!-- Spacing -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ═══════════════ 1. HEADER SECTION ═══════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,10" MouseDown="Window_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Ổ Khóa Đỏ -->
                <Border Grid.Column="0"
                        Width="48" Height="48"
                        Background="#FEE2E2"
                        CornerRadius="12"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                          Fill="#EF4444"
                          Width="22" Height="22"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <!-- Tiêu Đề & Phụ Đề -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Lic_Title}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="{DynamicResource Loc_Lic_Subtitle}"
                               FontSize="11"
                               Foreground="#475569"
                               LineHeight="16"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Nghệ Thuật Minh Họa Hacker (No License No Access) & Nút Đóng -->
                <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0,-6,-10,0">
                    <Image Source="/Simulate;component/Assets/license_hacker_art.png"
                           Height="82"
                           Stretch="Uniform"
                           HorizontalAlignment="Right"
                           Opacity="0.95"/>
                    <Button Click="BtnClose_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="24" Height="24"
                            Margin="0,2,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Đóng">
                        <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- ═══════════════ 2. MACHINE ID CARD ═══════════════ -->
            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_Lic_MachineIdTitle}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>
                    <TextBlock Text="{DynamicResource Loc_Lic_MachineIdDesc}"
                               FontSize="9.5"
                               Foreground="#64748B"
                               Margin="0,2,0,7"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ô hiển thị Machine ID -->
                        <Border Grid.Column="0"
                                Background="#F1F5F9"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Height="30"
                                Padding="8,0">
                            <TextBox Text="{Binding MachineId, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#334155"
                                     FontSize="11.5"
                                     FontWeight="SemiBold"
                                     FontFamily="Consolas, Segoe UI"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- Nút Sao Chép -->
                        <Button Grid.Column="1"
                                Command="{Binding CopyMachineIdCommand}"
                                Style="{StaticResource OutlineActionButtonStyle}"
                                Margin="8,0,0,0"
                                Height="30"
                                Padding="12,0"
                                ToolTip="Sao chép Machine ID">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                      Fill="#2563EB"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Loc_Lic_BtnCopy}"
                                           Foreground="#2563EB"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════ 3. LICENSE KEY CARD ═══════════════ -->
            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_Lic_KeyTitle}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>
                    <TextBlock Text="{DynamicResource Loc_Lic_KeyDesc}"
                               FontSize="9.5"
                               Foreground="#64748B"
                               Margin="0,2,0,7"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ô nhập License Key -->
                        <Border Grid.Column="0"
                                Background="#FFFFFF"
                                BorderBrush="#93C5FD"
                                BorderThickness="1"
                                CornerRadius="6"
                                Height="30"
                                Padding="6,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Chìa Khóa -->
                                <Path Grid.Column="0"
                                      Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                      Fill="#64748B"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Margin="4,0,6,0"
                                      VerticalAlignment="Center"/>

                                <!-- TextBox Nhập Liệu -->
                                <TextBox x:Name="TxtLicenseKey"
                                         Grid.Column="1"
                                         Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#1E293B"
                                         FontSize="11"
                                         VerticalContentAlignment="Center"/>

                                <!-- Watermark Text -->
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource Loc_Lic_KeyWatermark}"
                                           IsHitTestVisible="False"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"
                                           Visibility="{Binding ElementName=TxtLicenseKey, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                            </Grid>
                        </Border>

                        <!-- Nút Dán -->
                        <Button Grid.Column="1"
                                Command="{Binding PasteLicenseKeyCommand}"
                                Style="{StaticResource OutlineActionButtonStyle}"
                                Margin="8,0,0,0"
                                Height="30"
                                Padding="12,0"
                                ToolTip="Dán mã kích hoạt từ clipboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"
                                      Fill="#2563EB"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Loc_Lic_BtnPaste}"
                                           Foreground="#2563EB"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Khung Thông Báo Lỗi (Error Banner) -->
                    <Border Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,5"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                  Fill="#EF4444"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="2,0,7,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#DC2626"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════ 4. FOOTER ACTIONS ═══════════════ -->
            <Grid Grid.Row="4" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Nút Hướng Dẫn Kích Hoạt -->
                <Button Grid.Column="0"
                        Command="{Binding OpenGuideCommand}"
                        Style="{StaticResource OutlineActionButtonStyle}"
                        Height="32"
                        Padding="12,0"
                        ToolTip="Xem hướng dẫn kích hoạt">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16h-2v-2h2v2zm1.07-7.75l-.9.92C12.45 11.9 12 12.5 12 14h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"
                              Fill="#475569"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Loc_Lic_BtnGuide}"
                                   Foreground="#475569"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Nút Kích Hoạt -->
                <Button Grid.Column="2"
                        Command="{Binding ActivateCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Height="32"
                        Padding="22,0"
                        ToolTip="Kích hoạt ứng dụng với mã đã nhập">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                              Fill="White"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Loc_Lic_BtnActivate}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
